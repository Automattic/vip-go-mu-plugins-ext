# Exclude these files from `git archive` output, which is what GitHub uses for
# the "Source code" archives on each release, and what Composer downloads with
# `--prefer-dist`. If you develop against this plugin with Composer, use
# `--prefer-source`.
#
# The release workflow builds its ZIP from .distignore instead, so the two lists
# should match. Adding a new development-only file? Add it to both.
# https://blog.madewithlove.be/post/gitattributes/

# Directories
/.devcontainer/                  export-ignore
/.github/                        export-ignore
/.wordpress-org/                 export-ignore
/.wp-env/                        export-ignore
/.wpvip/                         export-ignore
/docs/                           export-ignore
/features/                       export-ignore
/fixtures/                       export-ignore
/src/                            export-ignore
/tests/                          export-ignore

# Files
/.distignore                     export-ignore
/.gitattributes                  export-ignore
/.gitignore                      export-ignore
/.wp-env.json                    export-ignore
/AGENTS.md                       export-ignore
/CHANGELOG.md                    export-ignore
/CONTRIBUTING.md                 export-ignore
/behat.yml                       export-ignore
/composer.json                   export-ignore
/composer.lock                   export-ignore
/eslint.config.cjs               export-ignore
/package.json                    export-ignore
/package-lock.json               export-ignore
/phpcs.xml.dist                  export-ignore
/phpstan.neon.dist               export-ignore
/phpunit.xml.dist                export-ignore
/phpunit-unit.xml.dist           export-ignore
/playwright.config.ts            export-ignore
/vip-manifest.yaml               export-ignore
/vip-manifest.schema.json        export-ignore

# Auto detect text files and perform LF normalization
# https://pablorsk.medium.com/be-a-git-ninja-the-gitattributes-file-e58c07c9e915

* text=auto

# The above will handle all files NOT found below

*.md text
*.php text
*.inc text
