{
  "name": "content-for-agents",
  "version": "0.5.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "files": [
    "build/",
    "includes/",
    "content-for-agents.php",
    "LICENSE",
    "docs/NOTICE.md",
    "docs/PLUGIN-GUIDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "cmd:format": "prettier '**/*.(js|json|jsx|md|ts|tsx|yml|yaml)'",
    "cmd:lint:js": "eslint --quiet .",
    "format": "npm run cmd:format -- --write",
    "format:check": "npm run cmd:format -- --check",
    "start": "wp-scripts start",
    "test:frontend": "wp-scripts test-unit-js --runInBand --watch=false",
    "typecheck": "tsc --noEmit",
    "lint:js": "npm run cmd:lint:js && npm run typecheck",
    "lint:js:fix": "npm run cmd:lint:js -- --fix",
    "plugin-zip": "npm run build && wp-scripts plugin-zip --no-root-folder",
    "test:integration": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/$(basename \"$(git rev-parse --show-toplevel)\")\" env WP_TESTS_DIR=/wordpress-phpunit ./vendor/bin/phpunit -c phpunit-integration.xml"
  },
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "1.3.1",
    "@wordpress/env": "^11.13.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/api-fetch": "^7.55.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^6.0.0",
    "eslint": "9.39.2",
    "prettier": "npm:wp-prettier@3.9.6",
    "typescript": "^6.0.3",
    "@types/react": "^18.3.31"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "npm": ">=10.0.0"
  },
  "author": {
    "name": "WPVIP",
    "url": "https://wpvip.com"
  }
}
