{
  "name": "safe-publish",
  "version": "0.0.2",
  "author": "WPVIP",
  "description": "Safe Publish plugin",
  "license": "GPL-2.0-or-later",
  "private": true,
  "main": "build/index.js",
  "files": [
    "assets/",
    "build/",
    "includes/",
    "vendor/",
    "safe-publish.php"
  ],
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=build",
    "build:docs:ai": "npx repomix --include='docs/**/*.md,example/**' --ignore='docs/extending/ai-prompts.md,docs/for-ai.md,docs/index.md,docs/quickstart.md' --style=markdown --output='docs/for-ai.md'",
    "check": "npm run lint:all && npm run format:check && npm run check-types",
    "check-types": "tsc --noEmit",
    "cmd:lint": "eslint --ext 'js,jsx,ts,tsx'",
    "dev": "./bin/start",
    "dev:build": "./bin/start build",
    "dev:destroy": "./bin/stop destroy",
    "dev:stop": "./bin/stop",
    "fix": "npm run lint:fix && npm run format && npm run lint:css:fix && npm run lint:phpcs:fix",
    "format": "prettier '**/*.(json|md|yml|yaml)' --write",
    "format:check": "prettier '**/*.(json|md|yml|yaml)' --check",
    "lint": "npm run cmd:lint .",
    "lint:all": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:fix": "npm run cmd:lint . -- --fix",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "npm run lint",
    "lint:php": "npm run lint:phpcs && npm run lint:psalm",
    "lint:phpcs": "vendor/bin/phpcs --cache",
    "lint:phpcs:fix": "vendor/bin/phpcbf",
    "lint:psalm": "vendor/bin/psalm.phar",
    "packages-update": "wp-scripts packages-update",
    "playground": "npx @wp-playground/cli server --mount=.:/wordpress/wp-content/plugins/safe-publish --php=8.2 --blueprint=blueprint.local.json",
    "playground:reset": "npm run playground -- --reset",
    "plugin-zip": "npm run build && composer install --prefer-dist --optimize-autoloader --no-dev && wp-scripts plugin-zip --no-root-folder",
    "postinstall": "composer install",
    "release": "./bin/release",
    "seed": "./bin/seed",
    "seed:destination": "./bin/seed site=destination",
    "seed:full": "./bin/seed preset=full",
    "seed:source": "./bin/seed site=source",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=build",
    "test": "npm run test:php && npm run test:js",
    "test:e2e": "wp-scripts test-playwright",
    "test:e2e:debug": "wp-scripts test-playwright --debug",
    "test:e2e:help": "wp-scripts test-playwright --help",
    "test:php": "composer test",
    "test:php:coverage": "composer test-coverage",
    "test:php:debug": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/$(basename \"$(git rev-parse --show-toplevel)\")\" ./vendor/bin/phpunit",
    "test:integration": "./bin/test-integration",
    "test:integration:sync-bidirectional": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/$(basename \"$(git rev-parse --show-toplevel)\")\" ./vendor/bin/phpunit -c ./phpunit-integration-sync-bidirectional.xml",
    "test:integration:sync-import": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/$(basename \"$(git rev-parse --show-toplevel)\")\" ./vendor/bin/phpunit -c ./phpunit-integration-sync-import.xml",
    "test:integration:sync-export": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/$(basename \"$(git rev-parse --show-toplevel)\")\" ./vendor/bin/phpunit -c ./phpunit-integration-sync-export.xml",
    "test:js": "vitest --watch=false",
    "test:js:watch": "vitest --watch=true",
    "test:js:coverage": "vitest --coverage --watch=false",
    "wp-cli": "wp-env run cli -- wp"
  },
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "0.13.1",
    "@babel/preset-react": "7.28.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "11.5.16",
    "@types/wordpress__blocks": "12.5.17",
    "@vitest/coverage-v8": "4.1.5",
    "@wordpress/api-fetch": "7.25.0",
    "@wordpress/block-editor": "14.20.0",
    "@wordpress/blocks": "14.14.0",
    "@wordpress/components": "29.11.0",
    "@wordpress/compose": "7.25.0",
    "@wordpress/core-data": "7.25.0",
    "@wordpress/data": "10.25.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.25.0",
    "@wordpress/dom-ready": "4.25.0",
    "@wordpress/e2e-test-utils-playwright": "^1.25.0",
    "@wordpress/editor": "14.25.0",
    "@wordpress/element": "6.26.0",
    "@wordpress/env": "10.25.0",
    "@wordpress/eslint-plugin": "^22.22.0",
    "@wordpress/hooks": "4.25.0",
    "@wordpress/i18n": "5.25.0",
    "@wordpress/icons": "10.25.0",
    "@wordpress/interactivity": "6.25.0",
    "@wordpress/notices": "5.25.0",
    "@wordpress/plugins": "7.25.0",
    "@wordpress/primitives": "4.25.0",
    "@wordpress/rich-text": "7.25.0",
    "@wordpress/scripts": "32.1.0",
    "@wordpress/server-side-render": "6.1.0",
    "@wordpress/url": "4.25.0",
    "eslint": "8.57.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "^3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylelint": "17.11.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.6.3",
    "vitest": "4.1.5"
  },
  "stylelint": {
    "extends": "./node_modules/@wordpress/scripts/config/.stylelintrc.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint"
    ],
    "*.{css,scss}": [
      "wp-scripts lint-style --fix",
      "wp-scripts lint-style"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write",
      "prettier --check"
    ],
    "*.php": [
      "vendor/bin/phpcs",
      "vendor/bin/psalm.phar --no-cache"
    ]
  },
  "dependencies": {
    "@automattic/calypso-analytics": "^1.1.5",
    "@wordpress/dataviews": "^4.22.0",
    "@wordpress/i18n": "^5.26.0",
    "diff": "^5.2.2"
  },
  "overrides": {
    "@babel/runtime": ">=7.26.10"
  }
}
