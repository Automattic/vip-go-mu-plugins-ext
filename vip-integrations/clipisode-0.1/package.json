{
	"name": "clipisode",
	"version": "0.1.0",
	"private": true,
	"description": "Clipisode WordPress plugin",
	"scripts": {
		"build": "wp-scripts build",
		"dev": "wp-scripts start",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"plugin": "wp-scripts build && wp-scripts plugin-zip",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"render:server": "node scripts/local-renderer.mjs",
		"test:renderer": "node --test tests/renderer/*.test.mjs"
	},
	"files": [
		"assets/",
		"build/",
		"includes/",
		"clipisode.php",
		"readme.txt"
	],
	"devDependencies": {
		"@babel/preset-env": "^7.29.0",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@remotion/bundler": "4.0.499",
		"@remotion/renderer": "4.0.499",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/qrcode": "^1.5.6",
		"@wordpress/jest-preset-default": "^12.40.0",
		"@wordpress/scripts": "^31.4.0"
	},
	"dependencies": {
		"@remotion/media": "4.0.499",
		"@remotion/player": "4.0.499",
		"@remotion/web-renderer": "4.0.499",
		"@wordpress/api-fetch": "^7.39.0",
		"@wordpress/components": "^32.1.0",
		"@wordpress/element": "^6.39.0",
		"@wordpress/i18n": "^6.12.0",
		"@wordpress/icons": "^11.6.0",
		"qrcode": "^1.5.4",
		"remotion": "4.0.499"
	}
}
